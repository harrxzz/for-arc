# For Arc — Environment Variables
# Copy this to .env.local for local development, or set the same keys in Vercel.

# Wallet auth / Privy. Required for the app UI to render beyond the setup fallback.
NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id

# Circle AppKit / Gateway. Required for unified balance / CCTP flows when those SDK calls need a client key.
NEXT_PUBLIC_KIT_KEY=your_circle_appkit_client_key

# AI Agent intent parser. Prefer Mistral if available; FreeModel is used as fallback.
MISTRAL_API_KEY=your_mistral_api_key
FREEMODEL_API_KEY=your_freemodel_api_key

# Optional OpenRouter key if the agent route is extended to use OpenRouter.
# OPENROUTER_API_KEY=sk-or-...
